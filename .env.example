# Copy this file to .env and fill in the values yourself.
# .env is gitignored. Never paste these values into chat and never commit them.

# Network selection for CLI/webapp defaults: mainnet | testnet.
# Reads default to mainnet, WRITES (anchor, loader) default to testnet.
#NVNM_NETWORK=mainnet

# NVNM mainnet (nvnm-1, EVM chain id 1611) RPC override; default is the public RPC.
#NVNM_MAINNET_RPC=https://evm.nvnmchain.io

# NVNM testnet (nvnm-testnet-1, EVM chain id 787111). All development WRITES happen here.
NVNM_TESTNET_RPC=https://evm.testnet.nvnmchain.io

# Funded testnet private key: 64 hex characters. The 0x prefix is optional
# (MetaMask exports without it; both forms work). Throwaway only; never a mainnet key.
NVNM_TESTNET_KEY=

# Mainnet signing is DISABLED by design in sessions. Ops-only, never in this file:
# it requires BOTH NVNM_MAINNET_WRITE_OK=1 and NVNM_MAINNET_KEY set in the
# process environment (config.signing_context refuses otherwise).

# CourtListener API token (free account at https://www.courtlistener.com).
# Needed from Phase 2 onward for incremental updates and spot checks.
COURTLISTENER_TOKEN=
